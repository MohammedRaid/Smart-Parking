# SmartPark backend configuration.
# Copy to backend/.env and adjust. Never commit real secrets.

# SQLite by default (zero setup). For MySQL/PostgreSQL use a SQLAlchemy DSN, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/smartpark
# DATABASE_URL=mysql+pymysql://user:pass@localhost:3306/smartpark
DATABASE_URL=

# Change this in production – it signs JWT sessions and QR tokens.
JWT_SECRET=dev-only-smartpark-secret-change-me
ACCESS_TOKEN_MINUTES=1440

# Razorpay. Leave empty to run the clearly-labelled TEST payment mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
